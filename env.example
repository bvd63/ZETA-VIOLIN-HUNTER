# ============================================================
# Zeta Violin Hunter — Environment Variables
# Copy this file to .env and fill in your values.
# In Railway: Settings → Variables → add each key.
# ============================================================

# --- TELEGRAM (required) ---
# 1. Message @BotFather on Telegram → /newbot → copy token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Message @userinfobot on Telegram → copy your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# --- EBAY BROWSE API (required for eBay scraper) ---
# Get at developer.ebay.com → Application Keys
# Client ID = App ID, Client Secret = Cert ID
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# --- GOOGLE CUSTOM SEARCH (free: 100 queries/day, API retires 2027-01-01) ---
# 1. API key: https://console.cloud.google.com → Custom Search API → Enable → Create key
# 2. Engine ID: https://programmablesearchengine.google.com → your engine → Search engine ID
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_cse_id_here
# Queries per run (2 runs/day → keep 2 × this ≤ 100)
GOOGLE_QUERIES_PER_RUN=48
# Skip Google if it already ran less than N hours ago (container restarts)
GOOGLE_GUARD_HOURS=10

# --- BRAVE SEARCH API (optional, recommended — Google CSE dies 2027-01-01) ---
# https://api-dashboard.search.brave.com → API key. $5 monthly credit ≈ 1000 queries.
BRAVE_API_KEY=
BRAVE_QUERIES_PER_RUN=16

# --- US EGRESS PROXY (optional) ---
# http://user:pass@host:port of a US residential/VPS proxy. Unlocks Guitar Center
# and routes Facebook Marketplace's Chromium through the US (sites block EU datacenter IPs).
US_PROXY_URL=

# --- STORAGE ---
# Mount a Railway volume (e.g. at /data) and point the DB there so dedup,
# price history and search cursors survive deploys.
DB_PATH=zeta_listings.db

# --- HTTP ---
# Railway injects PORT automatically. SEARCH_TOKEN protects POST /search and GET /status
# (send header X-Search-Token: <token> or ?token=<token>).
SEARCH_TOKEN=

# --- ALERTS ---
# Re-alert a known listing when its price drops by at least this percent
PRICE_DROP_PCT=15
# Telegram warning when a configured scraper fetched 0 items for N cycles in a row
WATCHDOG_ZERO_STREAK=3
# Send the "no new listings" message after every cycle (true/false)
SEND_NO_CHANGES=true
# Attach listing photos (sendPhoto) when available
SEND_PHOTOS=true

# --- REVERB API TOKEN (optional) ---
# Reverb works WITHOUT a token when a browser User-Agent is sent (the code does).
# A Personal Access Token (reverb.com → Account → Apps) only raises rate limits.
REVERB_API_TOKEN=

# --- REDDIT API (optional — if not set, Reddit scraper is skipped) ---
# Register at: https://www.reddit.com/prefs/apps → "script" type app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:ZetaViolinHunter:1.0 (by /u/yourusername)

# --- SCHEDULE ---
# Hours (in SEARCH_TIMEZONE) to run, comma separated. Default: once a day at 12:00 Romania time
SEARCH_HOURS=12
SEARCH_TIMEZONE=Europe/Bucharest

# --- YEAR FILTER ---
# MIN_YEAR = earliest manufacture year for Zeta violins (~1987)
# MAX_YEAR = leave unset → defaults to next calendar year automatically
MIN_YEAR=1980
# MAX_YEAR=

# --- PRICE FILTER (optional) ---
MIN_PRICE=0
MAX_PRICE=99999

# --- CONDITION FILTER ---
# used (default) = second-hand only: drops "New"/"Brand New"/"Open box"/"B-Stock",
#                  new-stock dealers (EXCLUDED_SELLERS) and shop language in titles.
#                  Any model or year is fine as long as it is second-hand.
# all            = no condition filtering
CONDITION=used
# Sellers / shops / domains that sell NEW Zeta stock (comma separated)
EXCLUDED_SELLERS=electricviolinshop,electric violin shop,zetaviolins,zeta violins,zetamusic.com

# --- RUNTIME HARDENING ---
SCRAPER_TIMEOUT_SEC=900
SCRAPER_RETRIES=1
SCRAPER_CONCURRENCY=4

# --- CRAIGSLIST TUNING ---
# Parallel requests against sapi.craigslist.org (4-16)
CRAIGSLIST_CONCURRENCY=10
# 0 = all areas of the countries below (413 US + ~55 CA)
CRAIGSLIST_MAX_US_CITIES=0
# Country codes from reference.craigslist.org/Areas
CRAIGSLIST_COUNTRIES=US,CA
