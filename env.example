# ============================================================
# Zeta Violin Hunter — Environment Variables
# Copy this file to .env and fill in your values.
# In Railway: Settings → Variables → add each key.
# ============================================================

# --- TELEGRAM (required) ---
# 1. Message @BotFather on Telegram → /newbot → copy token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Message @userinfobot on Telegram → copy your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# --- EBAY BROWSE API (required for eBay scraper) ---
# Get at developer.ebay.com → Application Keys
# Client ID = App ID, Client Secret = Cert ID
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# --- GOOGLE CUSTOM SEARCH (free: 100 queries/day) ---
# 1. API key: https://console.cloud.google.com → Custom Search API → Enable → Create key
# 2. Engine ID: https://programmablesearchengine.google.com → New engine → Search entire web
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=d269b1b967bf54856

# --- REVERB API TOKEN (strongly recommended) ---
# Without this Reverb returns 401 and the scraper finds nothing.
# Create at: reverb.com → Account → Apps → Personal Access Token (scope: public)
REVERB_API_TOKEN=your_reverb_personal_access_token_here

# --- REDDIT API (optional — if not set, Reddit scraper is skipped) ---
# Register at: https://www.reddit.com/prefs/apps → "script" type app
# User-agent format: platform:app_id:version (by /u/username)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=script:ZetaViolinHunter:1.0 (by /u/yourusername)

# --- OPENAI API (optional — enables AI false-positive filtering) ---
# Without this all listings pass through unverified.
# Get at: platform.openai.com → API keys
OPENAI_API_KEY=your_openai_api_key_here

# --- SCHEDULE ---
# Hour (UTC) to run daily search. 9 = 09:00 UTC = 12:00 Romania
# Bot runs 2x/day: 09:00 + 21:00 UTC (hardcoded in main.py, this var unused currently)
SEARCH_HOUR=9

# --- YEAR FILTER ---
# MIN_YEAR = earliest manufacture year for Zeta violins (~1987)
# MAX_YEAR = set to current year — listings mention purchase/listing year, not just manufacture year
MIN_YEAR=1980
MAX_YEAR=2026

# --- PRICE FILTER (optional) ---
MIN_PRICE=0
MAX_PRICE=99999

# --- CONDITION FILTER ---
# Options: all, new, used
CONDITION=all

# --- RUNTIME HARDENING ---
SCRAPER_TIMEOUT_SEC=900
SCRAPER_RETRIES=1
SCRAPER_CONCURRENCY=4

# --- CRAIGSLIST TUNING ---
CRAIGSLIST_CONCURRENCY=24
# 0 = all discovered US cities
CRAIGSLIST_MAX_US_CITIES=0
